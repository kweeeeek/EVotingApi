{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Database": {
    "ServerVersion": "8.0.46"
  },

  "Jwt": {
    "Key": "",
    "Issuer": "EVoting.Api",
    "Audience": "EVoting.Clients",
    "AdminTokenExpiryMinutes": 480,
    "KioskTokenExpiryMinutes": 480,
    "VoterTokenExpiryMinutes": 30
  },

  "Security": {
    "PasswordPepper": "",
    "KioskSecret": ""
  },

  "Eligibility": {
    "MinShareCapital": 3000,
    "MinSavingsDeposit": 4000
  },

  "RateLimit": {
    "VoteSubmitPerMinute": 60,
    "AdminLoginPerMinute": 10,
    "KioskLoginPerMinute": 10,
    "VoterVerifyPerMinute": 200
  },

  "Cache": {
    "CurrentEventTtlSeconds": 5,
    "CandidatesTtlMinutes": 2,
    "KioskHeartbeatTimeoutSeconds": 90
  },

  "Cors": {
    "AllowedOrigins": ""
  },

  "Monitoring": {
    "NginxStatusUrl": "http://127.0.0.1/nginx_status",
    "SlowRequestThresholdMs": 1000
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
